# Copy to .env and fill in. Never commit .env. Free tiers only: no paid API.
# The model: Gemini, free key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# The model's web searches: Linkup, free credit, key from https://app.linkup.so
LINKUP_API_KEY=
# Data agent: official Xetra prices for NASDAQ 3X (free plan on eodhd.com). Without it, NASDAQ 3X is left out.
EODHD_API_KEY=

# Optional model overrides
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_REASONING=gemini-4-hydrogen
