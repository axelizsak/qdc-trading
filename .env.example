# Copy to .env and fill in. Never commit .env. Free tools only: nothing that costs money.
# The model: Gemini, free key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Optional: the other team members' own free keys. The requests take turns between the keys.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Data agent: official Xetra prices for NASDAQ 3X (free plan on eodhd.com). Without it, NASDAQ 3X is left out.
EODHD_API_KEY=

# Optional model overrides
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_SEARCH=gemini-3.1-flash-lite
LLM_MODEL_REASONING=gemini-4-hydrogen
